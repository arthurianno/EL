<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name="com.elta.android.presentation.features.googlefit.RxGoogleFitAuthActivity"
            android:screenOrientation="portrait"
            android:theme="@style/GoogleFitTheme" />

        <activity
            android:name="com.elta.android.presentation.features.googlefit.HealthConnectAuthActivity"
            android:exported="false"
            android:theme="@style/GoogleFitTheme" />

        <!-- Health Connect интеграция -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity="com.elta.android.presentation.features.googlefit.HealthConnectAuthActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
    </application>


</manifest>
