<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape xmlns:android="http://schemas.android.com/apk/res/android"
            android:shape="rectangle">
            <solid android:color="@color/white" />
            <corners android:topLeftRadius="@dimen/card_corner" android:topRightRadius="@dimen/card_corner" />
            <stroke
                android:width="1dp"
                android:color="@color/diary_divider_color" />

        </shape>
    </item>

    <item android:top="2dp" android:left="1dp" android:right="1dp" android:bottom="1dp">
        <shape xmlns:android="http://schemas.android.com/apk/res/android"
            android:shape="rectangle">
            <solid android:color="@color/white" />
            <corners android:topLeftRadius="@dimen/card_corner" android:topRightRadius="@dimen/card_corner" />
        </shape>
    </item>
</layer-list>
