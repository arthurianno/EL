<resources>

    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/color_window_background</item>
        <item name="bottomSheetDialogTheme">@style/BottomSheetTransparentStyle</item>
    </style>

    <style name="BottomSheetTransparentStyle" parent="Theme.Design.BottomSheetDialog">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="TooltipStyle"></style>

    <style name="AppProgressBar" parent="Base.Widget.AppCompat.ProgressBar">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:indeterminateTint">@color/colorPrimary</item>
        <item name="android:indeterminate">true</item>
    </style>

    <style name="NumberPicker">
        <item name="android:layout_height">300dp</item>
        <item name="np_dividerThickness">0dp</item>
        <item name="np_fadingEdgeEnabled">true</item>
        <item name="np_fadingEdgeStrength">0.3</item>
        <item name="np_order">descending</item>
        <item name="np_typeface">roboto_bold.ttf</item>
        <item name="np_wheelItemCount">3</item>
        <item name="np_max_fling_velocity_coefficient">6</item>

        <item name="np_selectedTextAlign">selectedTextAlignCenter</item>
        <item name="np_selectedTextColor">@color/color_picker_weight_selected_text</item>
        <item name="np_selectedTextSize">@dimen/weight_picker_selected_text</item>

        <item name="np_textAlign">textAlignCenter</item>
        <item name="np_textColor">@color/color_picker_weight_unselected_text</item>
        <item name="np_textSize">@dimen/weight_picker_unselected_text</item>
    </style>

    <style name="NumberPicker.WeightLeft">
        <item name="android:layout_width">120dp</item>
        <item name="np_value">70</item>
        <item name="np_max">200</item>
        <item name="np_min">1</item>
    </style>

    <style name="NumberPicker.Сoma">
        <item name="android:textColor">@color/color_picker_weight_selected_text</item>
        <item name="android:textSize">@dimen/weight_picker_selected_text</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@font/roboto_bold</item>
    </style>

    <style name="NumberPicker.WeightRight">
        <item name="android:layout_width">40dp</item>
        <item name="np_value">0</item>
        <item name="np_max">9</item>
        <item name="np_min">0</item>
    </style>
</resources>
