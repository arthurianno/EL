<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/containerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.elta.android.presentation.widgets.TwoStateStatusView
                android:id="@+id/connectionStatusView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:state1_color="@color/color_background_disconnected"
                app:state1_text="@string/title_connection_lost"
                app:state2_color="@color/color_background_connected"
                app:state2_text="@string/title_connection_found" />

            <com.elta.android.presentation.widgets.status.StatusView
                android:id="@+id/syncStatusView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </FrameLayout>

    </LinearLayout>


    <FrameLayout
        android:id="@+id/splashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/splash_background"
        android:clickable="true"
        android:focusable="true"
        android:visibility="visible"
        android:elevation="100dp"
        >

        <ProgressBar
            android:id="@+id/splashProgress"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginBottom="160dp"
            android:indeterminate="true" />

    </FrameLayout>

</FrameLayout>
