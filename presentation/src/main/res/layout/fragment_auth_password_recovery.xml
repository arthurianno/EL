<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            tools:ignore="UselessParent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/padding_base"
                android:paddingTop="8dp"
                android:paddingEnd="@dimen/padding_base"
                android:paddingBottom="@dimen/padding_base">

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Headline1"
                    android:id="@+id/authPasswordRecoveryTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text="@string/auth_password_recovery_title" />

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Subtitle1"
                    android:id="@+id/authPasswordRecoverySubTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/auth_password_recovery_subtitle" />

                <com.rengwuxian.materialedittext.MaterialEditText
                    android:id="@+id/emailInputView"
                    style="@style/InputStyle.Email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:hint="@string/auth_password_recovery_email_hint" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="16dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:srcCompat="@drawable/ic_info" />

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/Caption1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="11dp"
                        android:layout_weight="1"
                        android:linksClickable="true"
                        android:text="@string/auth_password_recovery_email_description" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/sendLinkButtonView"
        style="@style/Button.Large"
        android:enabled="false"
        android:text="@string/auth_password_recovery_button_text"
        app:layout_constraintBottom_toBottomOf="parent" />
</LinearLayout>