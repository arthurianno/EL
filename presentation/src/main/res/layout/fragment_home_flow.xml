<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/containerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="72dp" />

    <LinearLayout
        android:id="@+id/bottomContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/white"
        android:orientation="vertical">

        <com.elta.android.presentation.widgets.BottomNavigationView
            android:id="@+id/homeBottomNavigationView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/homeActionView"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="5dp"
        android:background="@drawable/selector_home_button"
        android:elevation="8dp"
        android:stateListAnimator="@drawable/selector_home_button_animator">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:stateListAnimator="@drawable/selector_home_button_icon_animator"
            app:srcCompat="@drawable/ic_home_plus" />

    </FrameLayout>

    <com.elta.android.presentation.widgets.bottom_sheet.BottomSheetView
        android:id="@+id/homeBottomSheetView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:bottom_sheet_layout="@layout/layout_home_bottom_sheet" />

    <com.elta.android.presentation.widgets.bottom_sheet.BottomSheetView
        android:id="@+id/helpBottomSheetView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:bottom_sheet_layout="@layout/layout_help_glucose_format_bottom_sheet" />

    <com.elta.android.presentation.widgets.bottom_sheet.BottomSheetView
        android:id="@+id/syncErrorBottomSheetView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:bottom_sheet_layout="@layout/layout_sync_error_bottom_sheet" />

    <com.elta.android.presentation.widgets.bottom_sheet.BottomSheetView
        android:id="@+id/deviceHardwareErrorBottomSheetView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:bottom_sheet_layout="@layout/layout_device_hardware_error_bottom_sheet" />

    <com.elta.android.presentation.widgets.bottom_sheet.BottomSheetView
        android:id="@+id/deviceInvalidTimeBottomSheetView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:bottom_sheet_layout="@layout/layout_device_invalid_time_bottom_sheet" />
</FrameLayout>
