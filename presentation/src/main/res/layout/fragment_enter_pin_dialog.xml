<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_top_round_rect"
    android:clickable="true"
    android:focusable="true"
    android:gravity="bottom"
    android:orientation="vertical"
    android:paddingTop="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/dialogTitleView"
            style="@style/New.Headline4.BlackBlue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:text="@string/sync_state_pin_dialog_title" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/dialogCloseButtonView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="16dp"
            app:srcCompat="@drawable/ic_dialog_close" />

    </LinearLayout>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/dialogDescriptionTitleView"
        style="@style/New.Title2.ShadeBlack0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:text="@string/sync_state_pin_dialog_description" />

    <FrameLayout
        android:id="@+id/pinCodeInputContainerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_pin_code"
        android:paddingTop="2dp"
        android:paddingBottom="6dp">

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/pinCodeInputView"
            style="@style/New.Headline2.ShadeGreen2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:gravity="center"
            android:inputType="number"
            android:lines="1"
            android:maxLength="3"
            android:textCursorDrawable="@drawable/shape_cursor_pin"
            tools:text="432" />

    </FrameLayout>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/deviceNameView"
        style="@style/New.Caption1.ShadeBlack2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="40dp"
        android:drawableStart="@drawable/ic_info"
        android:drawablePadding="12dp"
        android:gravity="center_vertical"
        tools:text="Подключаемое устройство СателлитOnline" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/dialogActionButtonView"
        style="@style/Button.Large"
        android:focusable="true"
        android:text="@string/sync_state_pin_dialog_button" />

</LinearLayout>