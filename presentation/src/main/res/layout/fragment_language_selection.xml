<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pale_gray"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/contentStartGuideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_begin="24dp" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/contentEndGuideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_end="24dp" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/closeButtonView"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:src="@drawable/ic_dialog_close"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Приветственная надпись (только при первом запуске) -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/greetingView"
            style="@style/Body2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="84dp"
            android:paddingHorizontal="6dp"
            android:text="@string/language_selection_intro"
            android:textColor="@color/shade_black1"
            app:layout_constraintEnd_toEndOf="@id/contentEndGuideline"
            app:layout_constraintStart_toStartOf="@id/contentStartGuideline"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Заголовок "Язык интерфейса" / "Выберите язык..." -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/titleView"
            style="@style/Headline1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:paddingHorizontal="6dp"
            android:text="@string/language_selection_title"
            android:textColor="@color/black"
            app:layout_constraintEnd_toEndOf="@id/contentEndGuideline"
            app:layout_constraintStart_toStartOf="@id/contentStartGuideline"
            app:layout_constraintTop_toBottomOf="@id/greetingView" />

        <!-- Описание секции языка (только в режиме настроек) -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/languageSubtitleView"
            style="@style/Body2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingHorizontal="6dp"
            android:text="@string/language_settings_subtitle"
            android:textColor="@color/shade_black1"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="@id/contentEndGuideline"
            app:layout_constraintStart_toStartOf="@id/contentStartGuideline"
            app:layout_constraintTop_toBottomOf="@id/titleView"
            tools:visibility="visible" />

        <!-- Кнопка Русский -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/russianLanguageView"
            style="@style/Body1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_language_option_default"
            android:gravity="center"
            android:minHeight="56dp"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
            android:text="@string/language_russian"
            android:textColor="@color/black"
            app:layout_constraintEnd_toEndOf="@id/contentEndGuideline"
            app:layout_constraintStart_toStartOf="@id/contentStartGuideline"
            app:layout_constraintTop_toBottomOf="@id/languageSubtitleView" />

        <!-- Кнопка Английский -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/englishLanguageView"
            style="@style/Body1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_language_option_selected"
            android:gravity="center"
            android:minHeight="56dp"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
            android:text="@string/language_english"
            android:textColor="@color/white"
            app:layout_constraintEnd_toEndOf="@id/contentEndGuideline"
            app:layout_constraintStart_toStartOf="@id/contentStartGuideline"
            app:layout_constraintTop_toBottomOf="@id/russianLanguageView" />

        <!-- ===== СЕКЦИЯ РЕГИОНА ===== -->

        <!-- Заголовок "Регион" -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/regionTitleView"
            style="@style/Headline1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:paddingHorizontal="6dp"
            android:text="@string/region_section_title"
            android:textColor="@color/black"
            app:layout_constraintEnd_toEndOf="@id/contentEndGuideline"
            app:layout_constraintStart_toStartOf="@id/contentStartGuideline"
            app:layout_constraintTop_toBottomOf="@id/englishLanguageView" />

        <!-- Описание секции региона -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/regionSubtitleView"
            style="@style/Body2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingHorizontal="6dp"
            android:text="@string/region_section_subtitle"
            android:textColor="@color/shade_black1"
            app:layout_constraintEnd_toEndOf="@id/contentEndGuideline"
            app:layout_constraintStart_toStartOf="@id/contentStartGuideline"
            app:layout_constraintTop_toBottomOf="@id/regionTitleView" />

        <!-- Дропдаун выбора региона (Spinner) -->

        <!-- Кнопка Далее / Сохранить -->
        <androidx.appcompat.widget.AppCompatSpinner
            android:id="@+id/regionDropdownMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="32dp"
            android:background="@drawable/bg_language_option_default"
            android:minHeight="56dp"
            android:padding="16dp"
            android:spinnerMode="dropdown"
            app:layout_constraintBottom_toTopOf="@id/continueButtonView"
            app:layout_constraintEnd_toEndOf="@id/contentEndGuideline"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="@id/contentStartGuideline"
            app:layout_constraintTop_toBottomOf="@id/regionSubtitleView"
            app:layout_constraintVertical_bias="0.0" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/continueButtonView"
            style="@style/Button.Large"
            android:text="@string/on_boarding_next_button_title"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
