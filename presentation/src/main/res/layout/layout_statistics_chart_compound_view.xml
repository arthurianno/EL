<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="230dp"
    android:background="@color/white"
    android:orientation="horizontal">

    <HorizontalScrollView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">

        <com.elta.android.presentation.widgets.charts.statistics.StatisticsChartView
            android:id="@+id/statisticsChartView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </HorizontalScrollView>

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/shade_black2"
        android:layout_marginBottom="35dp"/>

    <LinearLayout
        android:layout_width="40dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="35dp">

        <android.support.v7.widget.AppCompatTextView
            android:id="@+id/sixValueView"
            style="@style/New.Overline.ShadeBlack2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:gravity="center_vertical|end"
            tools:text="6" />

        <android.support.v7.widget.AppCompatTextView
            android:id="@+id/fifthValueView"
            style="@style/New.Overline.ShadeBlack2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:gravity="center_vertical|end"
            tools:text="5" />

        <android.support.v7.widget.AppCompatTextView
            android:id="@+id/fourthValueView"
            style="@style/New.Overline.ShadeBlack2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:gravity="center_vertical|end"
            tools:text="4" />

        <android.support.v7.widget.AppCompatTextView
            android:id="@+id/thirdValueView"
            style="@style/New.Overline.ShadeBlack2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:gravity="center_vertical|end"
            tools:text="3" />

        <android.support.v7.widget.AppCompatTextView
            android:id="@+id/secondValueView"
            style="@style/New.Overline.ShadeBlack2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:gravity="center_vertical|end"
            tools:text="2" />

        <android.support.v7.widget.AppCompatTextView
            android:id="@+id/firstValueView"
            style="@style/New.Overline.ShadeBlack2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="4dp"
            android:layout_weight="1"
            android:gravity="center_vertical|end"
            tools:text="1" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/shade_black3" />

    </LinearLayout>
</LinearLayout>