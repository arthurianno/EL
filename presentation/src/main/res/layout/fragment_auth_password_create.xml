<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/layout_toolbar" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            tools:ignore="UselessParent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/padding_base"
                android:paddingTop="8dp"
                android:paddingEnd="@dimen/padding_base"
                android:paddingBottom="@dimen/padding_base">

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Headline1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text="@string/auth_password_create_title" />

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Subtitle1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/auth_password_create_subtitle" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp">

                    <com.rengwuxian.materialedittext.MaterialEditText
                        android:id="@+id/passwordInputView"
                        style="@style/InputStyle.Password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/auth_password_create_password_hint"
                        app:met_helperText="@string/auth_password_create_password_pattern" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/passwordVisibilityButtonView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="4dp"
                        app:srcCompat="@drawable/ic_show_password" />
                </FrameLayout>

            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/saveButtonView"
        style="@style/Button.Large"
        android:enabled="false"
        android:text="@string/auth_password_create_login_button_title"
        app:layout_constraintBottom_toBottomOf="parent" />
</LinearLayout>