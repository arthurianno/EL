<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/layout_toolbar" />

    <android.support.v4.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1">

        <android.support.constraint.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">

            <android.support.v7.widget.AppCompatTextView
                android:id="@+id/titleView"
                style="@style/New.Headline3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/profile_settings_change_password_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <android.support.v7.widget.AppCompatTextView
                android:id="@+id/descriptionView"
                style="@style/New.Title2.ShadeBlack0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/profile_settings_change_password_description"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/titleView" />

            <FrameLayout
                android:id="@+id/oldPasswordContainerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/descriptionView">

                <com.rengwuxian.materialedittext.MaterialEditText
                    android:id="@+id/oldPasswordView"
                    style="@style/InputStyle.Password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/profile_settings_change_password_old_hint" />

                <android.support.v7.widget.AppCompatImageView
                    android:id="@+id/oldPasswordVisibilityView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="4dp"
                    app:srcCompat="@drawable/ic_show_password" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/newPasswordContainerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/oldPasswordContainerView">

                <com.rengwuxian.materialedittext.MaterialEditText
                    android:id="@+id/newPasswordView"
                    style="@style/InputStyle.Password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/profile_settings_change_password_new_hint" />

                <android.support.v7.widget.AppCompatImageView
                    android:id="@+id/newPasswordVisibilityView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="4dp"
                    app:srcCompat="@drawable/ic_show_password" />
            </FrameLayout>
        </android.support.constraint.ConstraintLayout>
    </android.support.v4.widget.NestedScrollView>

    <android.support.v7.widget.AppCompatTextView
        android:id="@+id/changePasswordView"
        style="@style/Button.Large"
        android:enabled="false"
        android:text="@string/profile_settings_apply_changes"
        android:visibility="visible" />
</LinearLayout>