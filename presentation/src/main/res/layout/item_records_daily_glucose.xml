<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_record_group">

    <android.support.v7.widget.AppCompatTextView
        android:id="@+id/dailyRecordsTitleView"
        style="@style/New.Headline5.BlackBlue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="16dp"
        android:text="@string/main_records_daily_glucose_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <android.support.v7.widget.AppCompatTextView
        android:id="@+id/dailyRecordsSubTitleView"
        style="@style/New.Caption1.ShadeBlack2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="2dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dailyRecordsTitleView"
        tools:text="@string/main_records_daily_glucose_subtitle" />

    <View
        android:layout_width="match_parent"
        android:layout_height="144dp"
        app:layout_constraintTop_toBottomOf="@id/dailyRecordsSubTitleView" />

</android.support.constraint.ConstraintLayout>