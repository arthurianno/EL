<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar" />

    <FrameLayout
        android:id="@+id/frameView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            tools:ignore="UselessParent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/padding_base">


                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/backgroundImageView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_welcome"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:visibility="visible"
                    app:layout_constraintBottom_toTopOf="@id/titleLayoutLin"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed"
                    tools:visibility="visible" />

                <LinearLayout
                    android:id="@+id/titleLayoutLin"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toBottomOf="@id/backgroundImageView"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toTopOf="@id/authSubtitleView">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/authTitleView"
                        style="@style/Headline1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        tools:text="@string/registration_main_title_new_user" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/authTitleIconView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="12dp"
                        android:src="@drawable/ic_hand" />
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/authSubtitleView"
                    style="@style/Subtitle1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    app:layout_constraintTop_toBottomOf="@id/titleLayoutLin"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toTopOf="@id/emailInputView"
                    tools:text="@string/registration_main_subtitle" />

                <com.rengwuxian.materialedittext.MaterialEditText
                    android:id="@+id/emailInputView"
                    style="@style/InputStyle.Email"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:maxLength="254"
                    android:hint="@string/registration_main_email_hint"
                    app:layout_constraintTop_toBottomOf="@id/authSubtitleView"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toTopOf="@id/passwordFrameLayout" />

                <FrameLayout
                    android:id="@+id/passwordFrameLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:layout_constraintTop_toBottomOf="@id/emailInputView"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toTopOf="@id/errorStateView">

                    <com.rengwuxian.materialedittext.MaterialEditText
                        android:id="@+id/passwordInputView"
                        style="@style/InputStyle.Password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/registration_main_password_hint"
                        app:met_helperText="@string/registration_password_pattern" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/passwordVisibilityButtonView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="4dp"
                        app:srcCompat="@drawable/ic_show_password" />
                </FrameLayout>

                <com.elta.android.presentation.widgets.SimpleErrorView
                    android:id="@+id/errorStateView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:layout_constraintTop_toBottomOf="@id/passwordFrameLayout"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toTopOf="@id/privacyPolicyView" />

                <LinearLayout
                    android:id="@+id/privacyPolicyView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="4dp"
                    android:paddingBottom="24dp"
                    app:layout_constraintTop_toBottomOf="@id/errorStateView"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <CheckBox
                        android:id="@+id/policyConfirmationCheckBoxView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top"
                        android:layout_marginTop="4dp" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/policyDescriptionTextView"
                        style="@style/Body1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:linksClickable="true"
                        android:text="@string/registration_main_description_privacy_policy" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
    </FrameLayout>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/continueButtonView"
        style="@style/Button.Large"
        android:enabled="false"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:text="@string/registration_main_button_continue" />
</LinearLayout>