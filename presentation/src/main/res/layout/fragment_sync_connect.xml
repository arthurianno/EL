<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true">

    <include layout="@layout/layout_toolbar" />

    <FrameLayout
        android:id="@+id/syncStateContainerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <include layout="@layout/layout_sync_state_connect" />

        <include
            layout="@layout/layout_sync_state_device_found"
            android:visibility="gone" />

        <include
            layout="@layout/layout_sync_state_connected"
            android:visibility="gone" />

        <include
            layout="@layout/layout_sync_state_sync_completed"
            android:visibility="gone" />

    </FrameLayout>

</android.support.constraint.ConstraintLayout>