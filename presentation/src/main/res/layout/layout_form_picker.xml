<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <com.elta.android.presentation.widgets.picker.NumberPicker
            android:id="@+id/leftPickerView"
            style="@style/NumberPicker.Form"
            android:layout_width="wrap_content" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/comaView"
            style="@style/NumberPicker.Form.Coma"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="12dp"
            android:text="@string/coma"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/measurementFirstTextView"
            style="@style/NumberPicker.Form.MeasurementText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="17dp"
            android:visibility="gone" />

        <com.elta.android.presentation.widgets.picker.NumberPicker
            android:id="@+id/rightPickerView"
            style="@style/NumberPicker.Form"
            android:layout_width="wrap_content"
            android:layout_marginStart="32dp" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/measurementSecondTextView"
            style="@style/NumberPicker.Form.MeasurementText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="17dp"
            android:visibility="gone" />


    </LinearLayout>

    <FrameLayout
        android:id="@+id/fantom_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:clickable="true"
        android:focusableInTouchMode="true"
        android:visibility="gone"/>

</FrameLayout>