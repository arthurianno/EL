<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <android.support.v7.widget.AppCompatImageView
        android:id="@+id/genderIconView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toTopOf="@+id/genderMaleView"
        app:layout_constraintDimensionRatio="w,1:1.15"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:srcCompat="@drawable/ic_gender" />

    <LinearLayout
        android:id="@+id/genderMaleView"
        style="@style/Button.Small.Blue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="4dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/genderFemaleView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/genderIconView">

        <android.support.v7.widget.AppCompatImageView
            android:layout_width="22dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:duplicateParentState="true"
            app:srcCompat="@drawable/selector_male_icon" />

        <android.support.v7.widget.AppCompatTextView
            style="style/Typography.Button.Small.Text.Light"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="2dp"
            android:duplicateParentState="true"
            android:text="@string/on_boarding_gender_male"
            android:textColor="@color/button_small_light_text_color" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/genderFemaleView"
        style="@style/Button.Small.Blue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/genderMaleView"
        app:layout_constraintTop_toTopOf="@+id/genderMaleView">

        <android.support.v7.widget.AppCompatImageView
            android:layout_width="22dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:duplicateParentState="true"
            app:srcCompat="@drawable/selector_female_icon" />

        <android.support.v7.widget.AppCompatTextView
            style="style/Typography.Button.Small.Text.Light"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="2dp"
            android:duplicateParentState="true"
            android:text="@string/on_boarding_gender_female"
            android:textColor="@color/button_small_light_text_color" />
    </LinearLayout>


</android.support.constraint.ConstraintLayout>