<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:background="@drawable/bg_bottom_sheet_toolbar"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <TextView
        android:id="@+id/title"
        style="@style/Headline1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="24dp"

        android:text="@string/sync_connect_device_not_found" />

    <TextView
        android:id="@+id/error_sync_text"
        style="@style/Body1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:text="@string/sync_connection_error_text"
        android:visibility="gone"/>


    <include
        android:id="@+id/not_found_text"
        layout="@layout/layout_device_not_found"
        />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/confirmButtonView"
        style="@style/Button.Large"
        android:layout_gravity="bottom"
        android:layout_marginTop="24dp"
        android:text="@string/repeat_sync_button_text" />
</LinearLayout>
