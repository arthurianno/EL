<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_top_round_rect"
    android:orientation="vertical"
    android:paddingTop="23dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <android.support.v7.widget.AppCompatImageView
            android:id="@+id/dialogIconView"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:srcCompat="@drawable/ic_hb_a_1_c_big" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <android.support.v7.widget.AppCompatTextView
                android:id="@+id/dialogTitleView"
                style="@style/New.Headline4.BlackBlue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Диабет" />

            <android.support.v7.widget.AppCompatTextView
                android:id="@+id/dialogSubTitleView"
                style="@style/New.Caption1.ShadeBlack2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Уровень глюкозы" />

        </LinearLayout>

        <android.support.v7.widget.AppCompatImageView
            android:id="@+id/dialogCloseButtonView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/ic_dialog_close" />

    </LinearLayout>

    <android.support.v7.widget.AppCompatTextView
        android:id="@+id/dialogDescriptionTitleView"
        style="@style/New.Body1.BlackBlue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        tools:text="Уровень глюкозы" />

    <FrameLayout
        android:id="@+id/dialogContentСontainerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp" />

    <android.support.v7.widget.AppCompatTextView
        android:id="@+id/dialogActionButtonView"
        style="@style/Button.Large"
        tools:text="Выбрать" />
</LinearLayout>