<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@drawable/divider" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?selectableItemBackground"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/recordIconView"
            android:layout_width="32dp"
            android:layout_height="32dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/ic_event_medicaments" />


        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/recordLabelView"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:visibility="gone"
            android:layout_marginStart="18dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/ic_white_circle"
            android:padding="4dp"
            app:layout_constraintStart_toStartOf="@+id/recordIconView"
            app:layout_constraintTop_toTopOf="@+id/recordIconView"
            tools:src="@drawable/ic_skiing" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/recordTitleView"
            style="@style/New.Body2.BlackBlue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="16dp"
            android:ellipsize="end"
            android:lines="1"
            app:layout_constraintEnd_toStartOf="@+id/barrierView"
            app:layout_constraintStart_toEndOf="@+id/recordIconView"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Короткий" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/recordTypeView"
            style="@style/New.Caption1.ShadeBlack2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="16dp"
            android:ellipsize="end"
            android:lines="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/barrierView"
            app:layout_constraintStart_toEndOf="@+id/recordIconView"
            app:layout_constraintTop_toBottomOf="@+id/recordTitleView"
            tools:text="Инсулин" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrierView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="start"
            app:constraint_referenced_ids="recordCountView,recordDateView" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/recordCountView"
            style="@style/New.Body2.ShadeGreen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="3 ед" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/recordDateView"
            style="@style/New.Caption1.ShadeBlack2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/recordCountView"
            tools:text="в 11:30 (UTC +4)" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>